# ==============================================================================
# MediAssist Environment Configuration Template (.env.example)
# Copy this file to .env and provide your secret credentials.
# NOTE: DO NOT commit production credentials or actual API keys to version control.
# ==============================================================================

# Application Environment
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key
SERVER_NAME=
DATABASE_URL=sqlite:///users.db

# OAuth / Insecure Transport
# Set to 1 only during local development over HTTP; set to 0 in staging/production
OAUTHLIB_INSECURE_TRANSPORT=0
OAUTHLIB_RELAX_TOKEN_SCOPE=1

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Vector Database (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key

# Primary LLM & Key Pooling (Groq)
GROQ_API_KEY=your-primary-groq-api-key
# Comma-separated keys for automatic key rotation & rate-limit fallback
GROQ_API_KEYS=your-groq-key-1,your-groq-key-2

# Intent Classifier & Scope Routing (Phase 1-4)
INTENT_CLASSIFIER_MODE=llm
LLM_CLASSIFIER_MODEL=llama-3.1-8b-instant
LLM_CLASSIFIER_FALLBACK_MODEL=qwen/qwen3.8-27b
CLASSIFIER_TIMEOUT_S=2.5
CLASSIFIER_MIN_CONFIDENCE=0.7

# Asynchronous Task Queue & Redis Streams (Task Dispatcher & Worker)
REDIS_URL=redis://localhost:6379/0
TASK_STREAM=medical-background-tasks
DLQ_STREAM=medical-tasks-dlq

# Voice Integration & Telephony
DEEPGRAM_API_KEY=your-deepgram-api-key
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
VOICE_BACKEND_URL=http://localhost:5050

# Secondary Providers / Fallbacks
GEMINI_API_KEY=your-gemini-api-key
HF_TOKEN=your-huggingface-token

# Email & Alerting (Flask-Mail & Brevo)
MAIL_USERNAME=notifications@example.com
MAIL_PASSWORD=your-smtp-password-or-app-password
MAIL_DEFAULT_SENDER=notifications@example.com
BREVO_API_KEY=your-brevo-api-key

# Evaluation & Observability
EVAL_SAMPLE_RATE=0.1
EVAL_ALERT_EMAIL=security-alerts@example.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=medibot
LANGCHAIN_API_KEY=your-langsmith-api-key
